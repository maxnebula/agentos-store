{
  "id": "water_glass",
  "name": "Water Glass",
  "icon": "💎",
  "description": "Complex glass/water UI demo with clock, timer, notes, counter, quotes, themes",
  "longDescription": "A feature-rich micro-app demonstrating WebView capabilities: glassmorphism design with animated water background, live clock, countdown timer with progress bar, notes with localStorage persistence, counter with history log, inspirational quotes, and multiple theme colors.",
  "category": "tool",
  "version": "1.0.0",
  "author": "maxnebula",
  "instructions": "<style>*{box-sizing:border-box;margin:0;padding:0}body{min-height:100vh;background:linear-gradient(135deg,#0a1628 0%,#0d2137 50%,#0a2a4a 100%);font-family:-apple-system,BlinkMacSystemFont,sans-serif;color:#fff;overflow-x:hidden;padding:16px;position:relative}body::before{content:'';position:fixed;top:0;left:0;right:0;bottom:0;background:radial-gradient(circle at 20% 30%,rgba(0,180,255,0.1) 0%,transparent 50%),radial-gradient(circle at 80% 80%,rgba(0,255,200,0.07) 0%,transparent 50%);pointer-events:none;z-index:0}.water-drop{position:fixed;border-radius:50%;pointer-events:none;z-index:0;animation:float 6s ease-in-out infinite}.water-drop.d1{width:250px;height:250px;top:-60px;right:-80px;background:radial-gradient(circle at 30% 30%,rgba(0,200,255,0.08),transparent);animation-delay:0s}.water-drop.d2{width:350px;height:350px;bottom:-100px;left:-60px;background:radial-gradient(circle at 70% 70%,rgba(0,255,200,0.05),transparent);animation-delay:-3s}.water-drop.d3{width:150px;height:150px;top:40%;left:10%;background:radial-gradient(circle at 50% 50%,rgba(100,200,255,0.04),transparent);animation-delay:-1.5s}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}.content{position:relative;z-index:1;max-width:500px;margin:0 auto}.glass{background:rgba(255,255,255,0.05);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:20px;padding:20px;margin-bottom:14px;transition:border-color 0.3s}.glass:hover{border-color:rgba(255,255,255,0.18)}.tabs{display:flex;gap:6px;margin-bottom:14px;background:rgba(255,255,255,0.03);border-radius:16px;padding:4px}.tab{flex:1;padding:10px 6px;text-align:center;background:transparent;border:none;border-radius:12px;color:rgba(255,255,255,0.4);font-size:12px;cursor:pointer;touch-action:manipulation;transition:all 0.25s;font-weight:500}.tab.active{background:rgba(0,200,255,0.15);color:#fff;box-shadow:0 4px 15px rgba(0,200,255,0.1)}.tab:active{transform:scale(0.95)}.section{display:none}.section.active{display:block}.clock{font-size:44px;font-weight:200;text-align:center;letter-spacing:3px;font-variant-numeric:tabular-nums}.greeting{text-align:center;font-size:20px;margin-bottom:2px;font-weight:400}.date{text-align:center;color:rgba(255,255,255,0.45);font-size:13px;margin-top:4px}.btn{display:inline-block;padding:10px 18px;border:none;border-radius:12px;font-size:14px;cursor:pointer;touch-action:manipulation;transition:all 0.15s;font-weight:500;text-align:center}.btn:active{transform:scale(0.95)}.btn.primary{background:rgba(0,200,255,0.15);border:1px solid rgba(0,200,255,0.2);color:#fff}.btn.danger{background:rgba(255,80,80,0.15);border:1px solid rgba(255,80,80,0.2);color:#fff}.btn.success{background:rgba(0,255,150,0.15);border:1px solid rgba(0,255,150,0.2);color:#fff}.btn.small{padding:6px 12px;font-size:12px}.btn.gold{background:rgba(255,200,0,0.15);border:1px solid rgba(255,200,0,0.2);color:#fff}.timer-display{font-size:52px;font-weight:200;text-align:center;letter-spacing:4px;font-variant-numeric:tabular-nums}.timer-presets{display:flex;gap:6px;margin-bottom:10px;flex-wrap:wrap}.timer-presets .btn{flex:1;min-width:55px;padding:8px 4px;font-size:12px}.timer-actions{display:flex;gap:8px}.timer-actions .btn{flex:1}.progress-track{height:4px;background:rgba(255,255,255,0.06);border-radius:3px;margin-bottom:14px;overflow:hidden}.progress-fill{height:100%;background:linear-gradient(90deg,#00c8ff,#00ffc8);border-radius:3px;width:100%;transition:width 0.3s ease}.notes-input{display:flex;gap:8px;margin-bottom:10px}.notes-input input{flex:1;padding:10px 14px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:12px;color:#fff;font-size:14px;outline:none}.notes-input input::placeholder{color:rgba(255,255,255,0.25)}.notes-input input:focus{border-color:rgba(0,200,255,0.3)}.note-item{display:flex;align-items:center;gap:8px;padding:10px 14px;background:rgba(255,255,255,0.03);border-radius:12px;margin-bottom:6px;border:1px solid rgba(255,255,255,0.04)}.note-item .text{flex:1;font-size:14px;line-height:1.4}.empty-state{text-align:center;padding:24px;color:rgba(255,255,255,0.15);font-size:14px}.counter-display{font-size:64px;font-weight:200;text-align:center;letter-spacing:2px;font-variant-numeric:tabular-nums}.counter-actions{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}.counter-actions .btn{min-width:52px}.history-entry{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid rgba(255,255,255,0.03);font-size:13px;color:rgba(255,255,255,0.4)}.quote-box{text-align:center;padding:16px}.quote-text{font-size:15px;font-style:italic;line-height:1.6;color:rgba(255,255,255,0.75)}.quote-author{font-size:12px;color:rgba(255,255,255,0.35);margin-top:8px}.theme-dots{display:flex;gap:8px;justify-content:center;margin-bottom:12px}.theme-dot{width:36px;height:36px;border-radius:50%;border:2px solid transparent;cursor:pointer;transition:all 0.2s}.theme-dot.active{border-color:#fff;transform:scale(1.15)}.theme-dot:active{transform:scale(0.9)}.row{display:flex;gap:8px;margin-bottom:8px}.badge{display:inline-block;padding:2px 10px;border-radius:20px;font-size:11px;background:rgba(0,200,255,0.12);color:rgba(0,200,255,0.7)}</style><div class=content><div class=tabs><button class=tab active onclick=switchTab('home')>🏠<br><span style=font-size:10px>Home</span></button><button class=tab onclick=switchTab('timer')>⏱<br><span style=font-size:10px>Timer</span></button><button class=tab onclick=switchTab('notes')>📝<br><span style=font-size:10px>Notes</span></button><button class=tab onclick=switchTab('counter')>🔢<br><span style=font-size:10px>Counter</span></button><button class=tab onclick=switchTab('more')>⚙<br><span style=font-size:10px>More</span></button></div><div id=s-home class='section active'><div class=glass style=text-align:center;padding:32px 20px><div class=greeting id=greeting>Loading...</div><div class=clock id=clock>00:00</div><div class=date id=date>--</div></div><div class=glass><div style=display:flex;justify-content:space-between;align-items:center;margin-bottom:12px><span style=color:rgba(255,255,255,0.4);font-size:12px>QUOTE OF THE DAY</span><button class="btn primary small" onclick=newQuote()>↻</button></div><div class=quote-box><div class=quote-text id=quoteText>Loading...</div><div class=quote-author id=quoteAuthor>--</div></div></div><div class=glass><div style=display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px><div style=background:rgba(255,255,255,0.03);border-radius:12px;padding:12px;text-align:center><div style=font-size:11px;color:rgba(255,255,255,0.35);margin-bottom:4px>SCREEN</div><div style=font-size:14px;font-weight:500 id=scrRes>-</div></div><div style=background:rgba(255,255,255,0.03);border-radius:12px;padding:12px;text-align:center><div style=font-size:11px;color:rgba(255,255,255,0.35);margin-bottom:4px>AGENT</div><div style=font-size:14px;font-weight:500;color:#4ade80>Online</div></div><div style=background:rgba(255,255,255,0.03);border-radius:12px;padding:12px;text-align:center><div style=font-size:11px;color:rgba(255,255,255,0.35);margin-bottom:4px>NOTES</div><div style=font-size:14px;font-weight:500 id=noteCount>0</div></div></div></div></div><div id=s-timer class=section><div class=glass style=text-align:center><div class=timer-display id=timerDisp>00:00</div><div class=progress-track><div class=progress-fill id=progressFill></div></div><div class=timer-presets><button class="btn primary small" onclick=setTimer(10)>10s</button><button class="btn primary small" onclick=setTimer(30)>30s</button><button class="btn primary small" onclick=setTimer(60)>1m</button><button class="btn primary small" onclick=setTimer(120)>2m</button><button class="btn primary small" onclick=setTimer(300)>5m</button><button class="btn primary small" onclick=customTimer()>∞</button></div><div class=timer-actions><button class="btn primary" id=timerBtn onclick=toggleTimer()>▶ Start</button><button class=btn style=background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:#fff onclick=resetTimer()>↺</button></div></div></div><div id=s-notes class=section><div class=glass><div class=notes-input><input id=noteInp placeholder='Write a note...' maxlength=200><button class="btn primary" onclick=addNote()>Add</button></div><div id=notesList></div></div></div><div id=s-counter class=section><div class=glass style=text-align:center;padding:24px 20px><div class=counter-display id=counterDisp>0</div><div class=counter-actions><button class="btn danger small" onclick=counterOp(0)>Reset</button><button class="btn primary small" onclick=counterOp(-10)>-10</button><button class="btn primary small" onclick=counterOp(-1)>-1</button><button class="btn primary small" onclick=counterOp(1)>+1</button><button class="btn primary small" onclick=counterOp(10)>+10</button></div></div><div class=glass><div style=font-size:12px;color:rgba(255,255,255,0.35);margin-bottom:8px;text-transform:uppercase;letter-spacing:1px>History</div><div id=histList><div class=empty-state>No actions yet</div></div></div></div><div id=s-more class=section><div class=glass><div style=font-size:14px;font-weight:500;margin-bottom:12px>🎨 Theme Colors</div><div class=theme-dots><div class='theme-dot active' style=background:linear-gradient(135deg,#00c8ff,#00ffc8) onclick=setTheme('teal') title=Teal></div><div class=theme-dot style=background:linear-gradient(135deg,#8B5CF6,#EC4899) onclick=setTheme('purple') title=Purple></div><div class=theme-dot style=background:linear-gradient(135deg,#F59E0B,#EF4444) onclick=setTheme('sunset') title=Sunset></div><div class=theme-dot style=background:linear-gradient(135deg,#10B981,#34D399) onclick=setTheme('emerald') title=Emerald></div><div class=theme-dot style=background:linear-gradient(135deg,#3B82F6,#A78BFA) onclick=setTheme('ocean') title=Ocean></div></div></div><div class=glass><div style=font-size:14px;font-weight:500;margin-bottom:8px>ℹ About</div><div style=font-size:13px;color:rgba(255,255,255,0.5);line-height:1.7>Water Glass is a demo micro-app built with pure HTML+CSS+JS, rendered in AgentOS WebView. It demonstrates glassmorphism design, localStorage persistence, live clock, countdown timer, notes, counter, and theme switching — all without any framework.</div></div><div class=glass style=text-align:center><div style=font-size:12px;color:rgba(255,255,255,0.25)&quot;>Water Glass v1.0.0 · AgentOS Store</div></div></div></div><script>function switchTab(t){document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));document.querySelectorAll('.tab').forEach(b=>b.classList.remove('active'));document.getElementById('s-'+t).classList.add('active');document.querySelectorAll('.tab')[['home','timer','notes','counter','more'].indexOf(t)].classList.add('active')}function updateClock(){const n=new Date();document.getElementById('clock').textContent=n.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});document.getElementById('date').textContent=n.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric',year:'numeric'});const h=n.getHours();document.getElementById('greeting').textContent=h<6?'🌙 Late Night':h<12?'☀️ Good Morning':h<18?'🌤 Good Afternoon':'🌅 Good Evening'}updateClock();setInterval(updateClock,1000);document.getElementById('scrRes').textContent=screen.width+'×'+screen.height;const quotes=[{q:'The best way to predict the future is to create it.',a:'Peter Drucker'},{q:'Simplicity is the ultimate sophistication.',a:'Leonardo da Vinci'},{q:'Code is like humor. When you have to explain it, its bad.',a:'Cory House'},{q:'First, solve the problem. Then, write the code.',a:'John Johnson'},{q:'Any fool can write code that a computer can understand. Good programmers write code that humans can understand.',a:'Martin Fowler'},{q:'The only way to go fast is to go well.',a:'Robert C. Martin'},{q:'Clean code always looks like it was written by someone who cares.',a:'Robert C. Martin'},{q:'Make it work, make it right, make it fast.',a:'Kent Beck'},{q:'Talk is cheap. Show me the code.',a:'Linus Torvalds'},{q:'Debugging is twice as hard as writing the code in the first place.',a:'Brian Kernighan'}];let qi=0;function showQuote(i){const q=quotes[i%quotes.length];document.getElementById('quoteText').textContent='"'+q.q+'"';document.getElementById('quoteAuthor').textContent='— '+q.a}function newQuote(){qi=(qi+1)%quotes.length;showQuote(qi)}showQuote(0);let timerTotal=60,timerRemain=60,timerInt=null;function setTimer(s){timerTotal=s;timerRemain=s;updTimer();if(timerInt){clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='▶ Start'}}function updTimer(){const m=Math.floor(timerRemain/60),s=timerRemain%60;document.getElementById('timerDisp').textContent=String(m).padStart(2,'0')+':'+String(s).padStart(2,'0');document.getElementById('progressFill').style.width=(timerTotal>0?(timerRemain/timerTotal)*100:100)+'%'}function toggleTimer(){if(timerInt){clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='▶ Start';return}if(timerRemain<=0)setTimer(60);document.getElementById('timerBtn').textContent='⏸ Pause';timerInt=setInterval(()=>{timerRemain--;if(timerRemain<=0){timerRemain=0;clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='▶ Start'}updTimer()},1000)}function resetTimer(){if(timerInt){clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='▶ Start'}setTimer(timerTotal>0?timerTotal:60)}function customTimer(){const s=prompt('Enter seconds:');if(s&&!isNaN(s)&&Number(s)>0)setTimer(parseInt(s))}setTimer(60);function loadNotes(){const l=document.getElementById('notesList'),notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');document.getElementById('noteCount').textContent=notes.length;if(!notes.length){l.innerHTML='<div class=empty-state>📝 No notes yet</div>';return}l.innerHTML=notes.map((n,i)=>'<div class=note-item><span class=text>'+n+'</span><button class="btn danger small" onclick=delNote('+i+')>✕</button></div>').join('')}function addNote(){const inp=document.getElementById('noteInp');if(!inp.value.trim())return;const notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');notes.push(inp.value.trim());localStorage.setItem('wg_notes',JSON.stringify(notes));inp.value='';loadNotes()}function delNote(i){const notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');notes.splice(i,1);localStorage.setItem('wg_notes',JSON.stringify(notes));loadNotes()}loadNotes();let cnt=0,hist=[];function counterOp(d){if(d===0){cnt=0;hist=[]}else{cnt+=d;const sign=d>0?'+':'';hist.unshift(cnt-(d)+' '+sign+d+' → '+cnt);if(hist.length>30)hist.pop()}document.getElementById('counterDisp').textContent=cnt;renderHist()}function renderHist(){const l=document.getElementById('histList');if(!hist.length){l.innerHTML='<div class=empty-state>No actions yet</div>';return}l.innerHTML=hist.map(e=>'<div class=history-entry><span>'+e+'</span></div>').join('')}function setTheme(t){const colors={teal:{bg:'linear-gradient(135deg,#0a1628 0%,#0d2137 50%,#0a2a4a 100%)',accent:'0,200,255'},purple:{bg:'linear-gradient(135deg,#1a0a28 0%,#2d0a37 50%,#3a0a4a 100%)',accent:'139,92,246'},sunset:{bg:'linear-gradient(135deg,#28180a 0%,#37200d 50%,#4a2a0a 100%)',accent:'245,158,11'},emerald:{bg:'linear-gradient(135deg,#0a2818 0%,#0d3720 50%,#0a4a2a 100%)',accent:'16,185,129'},ocean:{bg:'linear-gradient(135deg,#0a1428 0%,#0d1f37 50%,#0a2a4a 100%)',accent:'59,130,246'}};const c=colors[t]||colors.teal;document.body.style.background=c.bg;document.querySelectorAll('.tab.active').forEach(el=>el.style.background='rgba('+c.accent+',0.15)');document.querySelectorAll('.btn.primary').forEach(el=>el.style.background='rgba('+c.accent+',0.15)');document.querySelectorAll('.btn.primary').forEach(el=>el.style.borderColor='rgba('+c.accent+',0.2)');document.querySelectorAll('.badge').forEach(el=>{el.style.background='rgba('+c.accent+',0.12)';el.style.color='rgb('+c.accent+')'});document.querySelectorAll('.theme-dot').forEach(d=>d.classList.remove('active'));document.querySelectorAll('.theme-dot')[['teal','purple','sunset','emerald','ocean'].indexOf(t)].classList.add('active');localStorage.setItem('wg_theme',t)}const saved=localStorage.getItem('wg_theme');if(saved)setTheme(saved)</script>