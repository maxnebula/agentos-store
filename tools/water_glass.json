{
  "id": "water_glass",
  "name": "Water Glass",
  "icon": "💧",
  "description": "Glass/water themed UI demo with clock, timer, notes",
  "longDescription": "A clean demo micro-app demonstrating proper WebView rendering with glassmorphism design, live clock, countdown timer, and notes with localStorage persistence.",
  "category": "micro_app",
  "version": "1.0.0",
  "author": "maxnebula",
  "instructions": "<style>\n*{box-sizing:border-box;margin:0;padding:0}\nbody{font-family:-apple-system,BlinkMacSystemFont,sans-serif;background:linear-gradient(135deg,#0a1628,#0d2137,#0a2a4a);min-height:100vh;color:#fff;padding:16px;overflow-x:hidden}\nh1{color:#8B5CF6;font-size:24px;margin-bottom:16px;font-weight:700}\n.glass{background:rgba(255,255,255,0.05);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.1);border-radius:16px;padding:16px;margin-bottom:12px}\n.clock{font-size:40px;font-weight:200;text-align:center;letter-spacing:3px;font-variant-numeric:tabular-nums;margin-bottom:4px}\n.greeting{text-align:center;font-size:18px;color:rgba(255,255,255,0.7);margin-bottom:2px}\n.date{text-align:center;color:rgba(255,255,255,0.4);font-size:13px}\n.tabs{display:flex;gap:6px;margin-bottom:12px;background:rgba(255,255,255,0.03);border-radius:12px;padding:4px}\n.tab{flex:1;padding:8px 4px;text-align:center;border:none;border-radius:10px;background:transparent;color:rgba(255,255,255,0.4);font-size:12px;cursor:pointer;touch-action:manipulation}\n.tab.active{background:rgba(0,200,255,0.15);color:#fff;font-weight:600}\n.tab:active{transform:scale(0.95)}\n.section{display:none}\n.section.active{display:block}\n.btn{display:inline-block;padding:8px 16px;border:none;border-radius:10px;font-size:13px;cursor:pointer;touch-action:manipulation;font-weight:500}\n.btn.primary{background:rgba(0,200,255,0.15);border:1px solid rgba(0,200,255,0.2);color:#fff}\n.btn:active{transform:scale(0.95)}\n.row{display:flex;gap:8px;margin-top:8px}\n.flex-1{flex:1}\n.grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}\n.stat-box{background:rgba(255,255,255,0.03);border-radius:10px;padding:10px;text-align:center}\n.stat-label{font-size:10px;color:rgba(255,255,255,0.35);margin-bottom:2px;text-transform:uppercase;letter-spacing:1px}\n.stat-value{font-size:14px;font-weight:500}\ninput{width:100%;padding:10px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:#fff;font-size:14px;outline:none}\ninput::placeholder{color:rgba(255,255,255,0.2)}\ninput:focus{border-color:rgba(0,200,255,0.3)}\n.note-item{display:flex;align-items:center;gap:8px;padding:8px 12px;background:rgba(255,255,255,0.03);border-radius:10px;margin-bottom:6px;font-size:14px}\n.note-item .del{background:rgba(255,80,80,0.15);border:1px solid rgba(255,80,80,0.2);color:#fff;border:none;border-radius:8px;padding:4px 10px;cursor:pointer;font-size:12px}\n.empty{text-align:center;padding:16px;color:rgba(255,255,255,0.15);font-size:13px}\n.label{color:rgba(255,255,255,0.4);font-size:11px;margin-bottom:4px;text-transform:uppercase;letter-spacing:1px}\n</style>\n<h1>&#x1F4A7; Water Glass</h1>\n<div class=tabs>\n<button class=tab active onclick=switchTab('home')>Home</button>\n<button class=tab onclick=switchTab('timer')>Timer</button>\n<button class=tab onclick=switchTab('notes')>Notes</button>\n<button class=tab onclick=switchTab('info')>Info</button>\n</div>\n\n<div id=s-home class='section active'>\n<div class=glass style=text-align:center;padding:24px>\n<div class=greeting id=greeting>--</div>\n<div class=clock id=clock>00:00</div>\n<div class=date id=date>--</div>\n</div>\n<div class=glass>\n<div class=grid-3>\n<div class=stat-box><div class=stat-label>Screen</div><div class=stat-value id=scrRes>-</div></div>\n<div class=stat-box><div class=stat-label>Engine</div><div class=stat-value style=color:#4ade80>WebView</div></div>\n<div class=stat-box><div class=stat-label>Status</div><div class=stat-value style=color:#4ade80>Online</div></div>\n</div>\n</div>\n</div>\n\n<div id=s-timer class=section>\n<div class=glass style=text-align:center>\n<div style=font-size:48px;font-weight:200;letter-spacing:4px id=timerDisp>00:00</div>\n<div style=height:4px;background:rgba(255,255,255,0.06);border-radius:3px;margin:12px 0;overflow:hidden>\n<div style=height:100%;background:linear-gradient(90deg,#00c8ff,#00ffc8);border-radius:3px;width:100%;transition:width 0.3s id=progressFill></div>\n</div>\n<div class=row>\n<button class='btn primary flex-1' onclick=setTimer(30)>30s</button>\n<button class='btn primary flex-1' onclick=setTimer(60)>60s</button>\n<button class='btn primary flex-1' onclick=setTimer(120)>2m</button>\n<button class='btn primary flex-1' onclick=setTimer(300)>5m</button>\n</div>\n<div class=row>\n<button class='btn primary flex-1' id=timerBtn onclick=toggleTimer()>Start</button>\n<button class='btn flex-1' style=background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.08);color:#fff onclick=resetTimer()>Reset</button>\n</div>\n</div>\n</div>\n\n<div id=s-notes class=section>\n<div class=glass>\n<div class=row><input id=noteInp placeholder='Write a note...' maxlength=200><button class='btn primary' onclick=addNote()>Add</button></div>\n<div id=notesList><div class=empty>No notes yet</div></div>\n</div>\n</div>\n\n<div id=s-info class=section>\n<div class=glass>\n<div class=label>About</div>\n<div style=font-size:14px;color:rgba(255,255,255,0.5);line-height:1.6>Water Glass is a demo micro-app showcasing WebView rendering in AgentOS. Built with pure HTML+CSS+JS.</div>\n</div>\n<div class=glass style=text-align:center>\n<div style=font-size:12px;color:rgba(255,255,255,0.25)>Water Glass v1.0.0</div>\n</div>\n</div>\n\n<script>\nfunction switchTab(t){\n document.querySelectorAll('.section').forEach(function(s){s.classList.remove('active')});\n document.querySelectorAll('.tab').forEach(function(b){b.classList.remove('active')});\n document.getElementById('s-'+t).classList.add('active');\n var tabs=['home','timer','notes','info'];\n document.querySelectorAll('.tab')[tabs.indexOf(t)].classList.add('active');\n}\nfunction updateClock(){\n var n=new Date();\n document.getElementById('clock').textContent=n.toLocaleTimeString([],{hour:'2-digit',minute:'2-digit',second:'2-digit'});\n document.getElementById('date').textContent=n.toLocaleDateString([],{weekday:'long',month:'long',day:'numeric',year:'numeric'});\n var h=n.getHours();\n document.getElementById('greeting').textContent=h<6?'Late Night':h<12?'Good Morning':h<18?'Good Afternoon':'Good Evening';\n}\nupdateClock();\nsetInterval(updateClock,1000);\ndocument.getElementById('scrRes').textContent=screen.width+'x'+screen.height;\n\nvar timerTotal=60,timerRemain=60,timerInt=null;\nfunction setTimer(s){\n timerTotal=s;timerRemain=s;updTimer();\n if(timerInt){clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='Start';}\n}\nfunction updTimer(){\n var m=Math.floor(timerRemain/60),s=timerRemain%60;\n document.getElementById('timerDisp').textContent=(m<10?'0':'')+m+':'+(s<10?'0':'')+s;\n document.getElementById('progressFill').style.width=(timerTotal>0?(timerRemain/timerTotal)*100:100)+'%';\n}\nfunction toggleTimer(){\n if(timerInt){\n  clearInterval(timerInt);timerInt=null;\n  document.getElementById('timerBtn').textContent='Start';return;\n }\n if(timerRemain<=0)setTimer(60);\n document.getElementById('timerBtn').textContent='Pause';\n timerInt=setInterval(function(){\n  timerRemain--;\n  if(timerRemain<=0){timerRemain=0;clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='Start';}\n  updTimer();\n },1000);\n}\nfunction resetTimer(){\n if(timerInt){clearInterval(timerInt);timerInt=null;document.getElementById('timerBtn').textContent='Start';}\n setTimer(timerTotal>0?timerTotal:60);\n}\nsetTimer(60);\n\nfunction loadNotes(){\n var notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');\n var list=document.getElementById('notesList');\n if(notes.length===0){list.innerHTML='<div class=empty>No notes yet</div>';return;}\n list.innerHTML=notes.map(function(n,i){\n  return '<div class=note-item><span style=flex:1>'+n+'</span><button class=del onclick=delNote('+i+')>X</button></div>';\n }).join('');\n}\nfunction addNote(){\n var inp=document.getElementById('noteInp');\n if(!inp.value.trim())return;\n var notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');\n notes.push(inp.value.trim());\n localStorage.setItem('wg_notes',JSON.stringify(notes));\n inp.value='';\n loadNotes();\n}\nfunction delNote(i){\n var notes=JSON.parse(localStorage.getItem('wg_notes')||'[]');\n notes.splice(i,1);\n localStorage.setItem('wg_notes',JSON.stringify(notes));\n loadNotes();\n}\nloadNotes();\n</script>",
  "downloads": 0,
