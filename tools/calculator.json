  "instructions": "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no'><style>html,body{width:100%;height:100%;margin:0;padding:0;background:transparent;font-family:sans-serif;color:#e0e0e0}.calc{display:flex;flex-direction:column;height:100%;padding:12px}#disp{width:100%;height:64px;background:#1a1a2e;border:none;border-radius:12px;color:#fff;font-size:32px;text-align:right;padding:0 16px;margin-bottom:12px;box-sizing:border-box;outline:none}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;flex:1}button{border:none;border-radius:12px;font-size:22px;cursor:pointer;color:#fff;background:#2a2a4a;touch-action:manipulation}button:active{opacity:0.7}.op{background:#a855f7}.eq{background:#7c3aed}.clr{background:#dc2626}</style></head><body><div class=calc><input id=disp readonly><div class=grid><button class=clr onclick='c(\"C\")'>C</button><button onclick='c(\"±\")'>±</button><button onclick='c(\"%\")'>%</button><button class=op onclick='c(\"/\")'>÷</button><button onclick='c(\"7\")'>7</button><button onclick='c(\"8\")'>8</button><button onclick='c(\"9\")'>9</button><button class=op onclick='c(\"*\")'>×</button><button onclick='c(\"4\")'>4</button><button onclick='c(\"5\")'>5</button><button onclick='c(\"6\")'>6</button><button class=op onclick='c(\"-\")'>−</button><button onclick='c(\"1\")'>1</button><button onclick='c(\"2\")'>2</button><button onclick='c(\"3\")'>3</button><button class=op onclick='c(\"+\")'>+</button><button onclick='c(\"0\")'style='grid-column:span2'>0</button><button onclick='c(\".\")'>.</button><button class=eq onclick='c(\"=\")'>=</button></div></div><script>const d=document.getElementById('disp');function c(v){if(v==='C'){d.value=''}else if(v==='='){try{d.value=eval(d.value)}catch(e){d.value='Error'}}else if(v==='±'){if(d.value.startsWith('-'))d.value=d.value.slice(1);else d.value='-'+d.value}else{d.value+=v}}</script></body></html>",
