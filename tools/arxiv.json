{
  "id": "arxiv",
  "name": "arXiv Search",
  "icon": "\uD83D\uDCD6",
  "description": "Find academic papers on arXiv by keyword.",
  "longDescription": "Search arXiv.org for academic papers across all scientific disciplines. Supports keyword search with optional category filters (e.g. cs.AI, cs.LG, math.ST, physics). Returns paper titles, authors, publication dates, links, and summaries sorted by relevance.",
  "category": "tool",
  "version": "1.0.0",
  "author": "maxnebula",
  "prompt": "",
  "parameters": "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Search query\"},\"max_results\":{\"type\":\"integer\",\"description\":\"Max results (default 5, max 50)\"}},\"required\":[\"query\"]}",
  "endpoints": {
    "search": {
      "method": "GET",
      "url": "https://export.arxiv.org/api/query",
      "query": {
        "search_query": { "from": "query", "required": true },
        "max_results": { "from": "max_results", "default": "5" },
        "sortBy": { "value": "relevance" },
        "start": { "value": "0" }
      },
      "response": {
        "maxChars": 4000,
        "recordSep": "<entry"
      }
    }
  },
  "actionMap": {
    "search": "search",
    "query": "search"
  },
  "responseType": "text",
  "maxResponseChars": 4000,
  "downloads": 0,
  "rating": 0.0,
  "size": "0.1 MB"
}
