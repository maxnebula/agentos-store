      "description": "Simple and fast note-taking micro-app with Markdown support",
      "longDescription": "A minimal note-taking app that saves your notes locally. Supports Markdown formatting, multiple notebooks, and search.\n\nFeatures:\n- Markdown support\n- Local persistence\n- Search notes\n- Multiple notebooks",
      "category": "tool",
      "version": "2.1.0",
      "author": "maxnebula",
      "instructions": "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'><style>body{font-family:sans-serif;padding:16px;color:#e0e0e0;background:#1a1a2e}textarea{width:100%;height:200px;background:#16213e;color:#e0e0e0;border:1px solid #333;border-radius:8px;padding:12px;font-size:14px}button{background:#a855f7;color:#fff;border:none;border-radius:8px;padding:10px 20px;margin-top:8px}.note{border:1px solid #333;border-radius:8px;padding:12px;margin-top:8px;background:#16213e}</style></head><body><h1>📝 Quick Notes</h1><textarea id='note' placeholder='Write your note here...'></textarea><br><button onclick='save()'>Save Note</button><div id='notes'></div><script>const notes=JSON.parse(localStorage.getItem('notes')||'[]');function render(){document.getElementById('notes').innerHTML=notes.map((n,i)=>`<div class=note>${n} <button onclick='del(${i})' style='float:right'>✕</button></div>`).join('')}function save(){const v=document.getElementById('note').value;if(v){notes.push(v);localStorage.setItem('notes',JSON.stringify(notes));document.getElementById('note').value='';render()}}function del(i){notes.splice(i,1);localStorage.setItem('notes',JSON.stringify(notes));render()}render()</script></body></html>",
