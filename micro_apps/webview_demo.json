{
  "id": "webview_demo",
  "name": "WebView Demo",
  "icon": "🌐",
  "description": "Demonstrates native WebView rendering works correctly",
  "longDescription": "A test micro-app that proves WebView renders properly with dark background, correct sizing, and working JavaScript.",
  "category": "micro_app",
  "version": "1.1.0",
  "author": "maxnebula",
  "instructions": "<style>*{box-sizing:border-box;margin:0;padding:0}body{font-family:-apple-system,sans-serif;background:#0A0A0F;color:#e0e0e0;padding:20px;min-height:100vh}h1{color:#8B5CF6;font-size:26px;margin-bottom:20px;font-weight:700;display:flex;align-items:center;gap:10px}.version{font-size:12px;background:#2a2a3d;color:#8B8FA3;border-radius:20px;padding:3px 10px;font-weight:400}.card{background:#151528;border-radius:14px;padding:18px;margin-bottom:12px;border:1px solid #2a2a3d}.label{color:#8B8FA3;font-size:12px;margin-bottom:6px;text-transform:uppercase;letter-spacing:1px}.value{color:#fff;font-size:20px;font-weight:600}.badge{display:inline-block;background:#10B981;color:#fff;border-radius:20px;padding:4px 12px;font-size:12px;font-weight:600;margin-top:8px}.badge.orange{background:#F59E0B}.badge.red{background:#EF4444}.row{display:flex;gap:10px;margin-bottom:12px}.row button{flex:1;background:#2a2a3d;border:none;border-radius:12px;padding:16px;color:#e0e0e0;font-size:16px;cursor:pointer;touch-action:manipulation}.row button:active{filter:brightness(1.4)}.row button.purple{background:#7c3aed;color:#fff}.counter{font-size:48px;font-weight:700;color:#8B5CF6;text-align:center;padding:20px}</style><h1>WebView Demo <span class=version>v1.1.0</span></h1><div class=card><div class=label>Rendering Status</div><div class=value>Dark Background (#0A0A0F) - OK</div><span class=badge>✓ Correct</span></div><div class=card><div class=label>Viewport</div><div class=value>device-width, scale=1.0</div></div><div class=card><div class=label>localStorage (Persistence)</div><div class=value id=visitDisplay>loading...</div><span class=badge id=storageBadge style=display:none>✓ Persists</span><span class=badge id=storageFail style=display:none>✗ Not Available</span></div><div class=card><div class=label>Network Status</div><div class=value id=netStatus>checking...</div></div><div class=card><div class=label>JavaScript Counter</div><div class=counter id=count>0</div><div class=row><button class=purple onclick='document.getElementById(\"count\").textContent=+document.getElementById(\"count\").textContent+1'>+1</button><button onclick='document.getElementById(\"count\").textContent=0'>Reset</button></div></div><div class=card><div class=label>Screen Info</div><div class=value id=screenInfo>loading...</div></div><script>document.getElementById('screenInfo').textContent=screen.width+'x'+screen.height+'px @ '+window.devicePixelRatio+'x';var n=navigator.onLine?'Online ✓':'Offline ✗';document.getElementById('netStatus').textContent=n;try{localStorage.setItem('_wd_test','1');var v=localStorage.getItem('_wd_visits')||0;v=+v+1;localStorage.setItem('_wd_visits',v);document.getElementById('visitDisplay').textContent=v+' visit'+(v>1?'s':'');document.getElementById('storageBadge').style.display='inline-block'}catch(e){document.getElementById('visitDisplay').textContent='Not supported';document.getElementById('storageFail').style.display='inline-block'}</script>"
}
