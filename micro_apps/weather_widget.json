  "instructions": "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'><style>body{font-family:sans-serif;background:#0a0a1a;display:flex;justify-content:center;align-items:center;height:100vh;margin:0;color:#fff;flex-direction:column}h1{font-size:3em;margin:0;color:#a855f7}.temp{font-size:4em;font-weight:bold;color:#fff}.desc{color:#888;font-size:1.2em;margin:10px 0}.forecast{display:flex;gap:12px;margin-top:20px}.day{background:#1a1a2e;border-radius:12px;padding:12px;text-align:center;min-width:60px}.day .dow{color:#888;font-size:12px}.day .hi{color:#fff;font-weight:bold}.day .lo{color:#666}</style></head><body><h1>🌤️</h1><div class=temp>72°F</div><div class=desc>Partly Cloudy</div><div style='color:#888'>San Francisco • Updated just now</div><div class=forecast><div class=day><div class=dow>Mon</div><div>☀️</div><div class=hi>74°</div><div class=lo>62°</div></div><div class=day><div class=dow>Tue</div><div>⛅</div><div class=hi>71°</div><div class=lo>60°</div></div><div class=day><div class=dow>Wed</div><div>🌧️</div><div class=hi>68°</div><div class=lo>58°</div></div><div class=day><div class=dow>Thu</div><div>☀️</div><div class=hi>73°</div><div class=lo>61°</div></div><div class=day><div class=dow>Fri</div><div>☀️</div><div class=hi>76°</div><div class=lo>64°</div></div></div></body></html>",
