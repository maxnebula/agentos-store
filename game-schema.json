{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maxnebula.github.io/agentos-store/game-schema.json",
  "title": "AgentOS Store Game Package",
  "description": "Engine-agnostic game package format for the AgentOS store. Games are declarative content packages driven by in-app engines (engine/content separation); the store never ships executable platform code. The core block is shared by every engine; engine-specific content is declared under 'world' (native2d) or as a zip bundle (web).",
  "type": "object",
  "required": ["id", "name", "description", "category", "version", "engine", "minEngineVersion"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]{1,32}$",
      "description": "Unique game id, lowercase alphanumeric with _ and -"
    },
    "name": { "type": "string", "minLength": 1 },
    "icon": { "type": "string", "description": "Single emoji or short text shown in the store" },
    "description": { "type": "string", "minLength": 1 },
    "longDescription": { "type": "string" },
    "category": { "const": "game" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Semver of the game package" },
    "author": { "type": "string" },
    "engine": {
      "enum": ["web", "native2d"],
      "description": "In-app engine that plays this game. Unknown engines are rejected at install by the app's EngineRegistry."
    },
    "minEngineVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Lowest app ENGINE_VERSION this game runs on. Install is rejected when minEngineVersion > app ENGINE_VERSION."
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "description": "Engine=web only: relative path of the entry point inside the bundle zip (e.g. index.html). Must exist in the bundle (checked by build_games.py and at install)."
    },
    "assets": {
      "type": "object",
      "description": "Engine=web only: bundle metadata. Written by build_games.py; sha256/size/url must match the built zip - mismatches fail validation.",
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://", "description": "Bundle zip URL (raw.githubusercontent.com/agentos-store/dist/games/<id>/bundle.zip)" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "Hex sha256 of the bundle zip; written by build_games.py" },
        "size": { "type": "integer", "minimum": 0, "description": "Bundle zip size in bytes; written by build_games.py" }
      }
    },
    "screenshots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^https://" }
    },
    "size": {
      "type": "string",
      "description": "Human-readable size label; written by build_games.py"
    },
    "world": {
      "$ref": "#/definitions/world2d",
      "description": "Engine=native2d only: full declarative world definition played by the in-app 2D engine. Forbidden for engine=web."
    }
  },
  "if": { "properties": { "engine": { "const": "web" } }, "required": ["engine"] },
  "then": {
    "required": ["entry"],
    "properties": { "world": false }
  },
  "else": {
    "required": ["world"],
    "properties": { "entry": false, "assets": false }
  },
  "definitions": {
    "world2d": {
      "type": "object",
      "required": ["size", "blocks", "worldgen", "player", "hotbar"],
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "object",
          "required": ["width", "height"],
          "additionalProperties": false,
          "properties": {
            "width": { "type": "integer", "minimum": 64, "maximum": 2048, "description": "World width in blocks" },
            "height": { "type": "integer", "minimum": 32, "maximum": 512, "description": "World height in blocks" }
          }
        },
        "seed": { "type": "integer", "minimum": 0, "description": "World seed; 0 = random at world creation" },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "description": "Tile registry; ids must be unique. Block id 0 is reserved for air and must not be declared. Cross-references (worldgen/hotbar) are checked by build_games.py and at install.",
          "items": {
            "type": "object",
            "required": ["id", "name", "color"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
              "name": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "description": "Fill color of the tile" },
              "icon": { "type": "string", "description": "Optional emoji overlay rendered in-world" },
              "solid": { "type": "boolean", "default": true, "description": "Collides with the player and can be placed" },
              "liquid": { "type": "boolean", "default": false, "description": "Rendered transparently, not solid" }
            }
          }
        },
        "worldgen": {
          "type": "object",
          "required": ["seaLevel", "heightmap", "surface", "sub", "deep"],
          "additionalProperties": false,
          "properties": {
            "seaLevel": { "type": "integer", "minimum": 0, "description": "Blocks below or equal to this y are filled with the sea tile outside land. Must be within world height (checked by build_games.py)." },
            "seaTile": { "type": "string", "description": "Tile id used for sea fill. Defaults to the first tile flagged liquid." },
            "bedrock": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$", "description": "Optional tile id placed at the bottom row y=0." },
            "surface": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$", "description": "Tile id of the top terrain layer." },
            "sub": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$", "description": "Tile id of the layer just below the surface." },
            "deep": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$", "description": "Tile id of the deep underground layers (also the ore host rock)." },
            "heightmap": {
              "type": "object",
              "required": ["baseHeight", "scale"],
              "additionalProperties": false,
              "properties": {
                "baseHeight": { "type": "integer", "minimum": 1 },
                "scale": { "type": "number", "exclusiveMinimum": 0 },
                "amplitude": { "type": "number", "minimum": 0.0 },
                "octaves": { "type": "integer", "minimum": 1, "maximum": 6 },
                "persistence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "lacunarity": { "type": "number", "exclusiveMinimum": 1.0 }
              }
            },
            "caves": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean", "default": false },
                "density": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.005 },
                "maxHeight": { "type": "integer", "minimum": 1 }
              }
            },
            "trees": {
              "type": "object",
              "required": ["block", "leafBlock", "density", "minHeight", "maxHeight"],
              "additionalProperties": false,
              "properties": {
                "block": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
                "leafBlock": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
                "density": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
                "minHeight": { "type": "integer", "minimum": 1 },
                "maxHeight": { "type": "integer", "minimum": 1 },
                "surface": { "type": "array", "description": "Tile ids trees may grow on. Defaults to every solid non-liquid tile.", "items": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" } }
              }
            },
            "ores": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["block", "count", "minY", "maxY"],
                "additionalProperties": false,
                "properties": {
                  "block": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" },
                  "count": { "type": "integer", "minimum": 1 },
                  "minY": { "type": "integer", "minimum": 0 },
                  "maxY": { "type": "integer", "minimum": 1 }
                }
              }
            }
          }
        },
        "player": {
          "type": "object",
          "required": ["reach"],
          "additionalProperties": false,
          "properties": {
            "spawnX": { "oneOf": [{ "const": "auto" }, { "type": "integer", "minimum": 0 }], "default": "auto" },
            "reach": { "type": "number", "minimum": 1.0, "maximum": 12.0, "description": "Block reach in blocks" },
            "width": { "type": "number", "minimum": 0.1, "maximum": 2.0, "default": 0.6 },
            "height": { "type": "number", "minimum": 0.2, "maximum": 4.0, "default": 1.8 },
            "speed": { "type": "number", "exclusiveMinimum": 0, "default": 5.0 },
            "jumpSpeed": { "type": "number", "exclusiveMinimum": 0, "default": 9.0 },
            "gravity": { "type": "number", "exclusiveMinimum": 0, "default": 22.0 }
          }
        },
        "hotbar": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": { "type": "string", "pattern": "^[a-z0-9_]{1,32}$" }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sky": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#1A1A2E" },
            "sea": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#2196F3" },
            "ground": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#14141F" },
            "highlight": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#FFFFFF" }
          }
        }
      }
    }
  }
}
