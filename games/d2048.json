{
  "id": "d2048",
  "name": "d2048",
  "icon": "🎮",
  "description": "A polished 2048 puzzle game with smooth animations, touch swipe, high scores, and Web Audio effects",
  "longDescription": "Classic 2048 with a dark AgentOS-themed makeover. Swipe to merge tiles, chain combos, and chase your best score. Features animated tile slides, merge particles, sound effects, and persistent high scores via localStorage.",
  "category": "game",
  "version": "1.0.0",
  "author": "maxnebula",
  "instructions": "<style>*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent;user-select:none}html,body{width:100%;height:100%;overflow:hidden;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:#e0e0e0;touch-action:none}.wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh;padding:12px}.head{width:100%;max-width:420px;display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}.head h1{font-size:28px;font-weight:800;color:#8B5CF6;letter-spacing:-.5px}.scores{display:flex;gap:8px}.scores>div{background:#151528;border-radius:10px;padding:4px 12px;text-align:center;border:1px solid #2a2a3d;min-width:72px}.scores .lbl{font-size:9px;color:#8B8FA3;text-transform:uppercase;letter-spacing:1px}.scores .val{font-size:18px;font-weight:700;color:#fff}.grid-wrap{position:relative;width:100%;max-width:420px;aspect-ratio:1;background:#0D0D1A;border-radius:16px;border:1px solid #1a1a2e;padding:8px;overflow:hidden}.grid-bg{display:grid;grid-template-columns:repeat(4,1fr);grid-template-rows:repeat(4,1fr);gap:8px;width:100%;height:100%}.cell{background:#151528;border-radius:8px;aspect-ratio:1}.tile{position:absolute;display:flex;align-items:center;justify-content:center;font-weight:800;border-radius:8px;transition:top .12s ease,left .12s ease,transform .1s ease,opacity .15s ease;z-index:2;overflow:hidden}.tile.appear{animation:pop .2s ease}.tile.merged{animation:merge .25s ease;z-index:3}@keyframes pop{0%{transform:scale(0);opacity:0}70%{transform:scale(1.1)}100%{transform:scale(1);opacity:1}}@keyframes merge{0%{transform:scale(1)}40%{transform:scale(1.2)}100%{transform:scale(1)}}.gover{position:absolute;inset:0;background:rgba(10,10,15,.82);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:10;border-radius:16px;animation:fadeIn .4s ease}@keyframes fadeIn{0%{opacity:0}100%{opacity:1}}.gover h2{font-size:36px;font-weight:800;color:#8B5CF6;margin-bottom:4px}.gover p{color:#8B8FA3;font-size:14px;margin-bottom:20px}.gover button{background:#7c3aed;border:none;border-radius:12px;padding:14px 40px;color:#fff;font-size:16px;font-weight:700;cursor:pointer;touch-action:manipulation}.gover button:active{filter:brightness(1.3)}.btm{width:100%;max-width:420px;display:flex;justify-content:space-between;align-items:center;margin-top:10px}.btm .hint{font-size:12px;color:#8B8FA3}.btm button{background:#2a2a3d;border:none;border-radius:10px;padding:8px 20px;color:#e0e0e0;font-size:13px;font-weight:600;cursor:pointer;touch-action:manipulation}.btm button:active{filter:brightness(1.4)}.particle{position:absolute;pointer-events:none;border-radius:50%;z-index:4;animation:partFly .6s ease-out forwards}@keyframes partFly{0%{transform:translate(0,0) scale(1);opacity:1}100%{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0}}</style><div class=wrap><div class=head><h1>d2048</h1><div class=scores><div><div class=lbl>Score</div><div class=val id=score>0</div></div><div><div class=lbl>Best</div><div class=val id=best>0</div></div></div></div><div class=grid-wrap id=gridWrap><div class=grid-bg id=gridBg></div></div><div class=btm><span class=hint>Swipe to move</span><button id=newBtn>New Game</button></div></div><script>(function(){var s=document.getElementById('score'),b=document.getElementById('best'),g=document.getElementById('gridWrap'),gw=document.getElementById('gridBg'),t=null,r=[],score=0,best=parseInt(localStorage.getItem('d2048_best')||'0'),cells=16,size=4;b.textContent=best;function T(){return g.getBoundingClientRect()}function initGrid(){for(var i=0;i<cells;i++){var d=document.createElement('div');d.className='cell';gw.appendChild(d)}}function randPos(){var e=[];for(var i=0;i<size;i++)for(var j=0;j<size;j++)if(r[i][j]===0)e.push([i,j]);if(e.length===0)return null;var p=e[Math.floor(Math.random()*e.length)];return p}function addTile(v){v=v||(Math.random()<.9?2:4);var p=randPos();if(!p)return false;r[p[0]][p[1]]=v;render();return true}function init(){r=[];for(var i=0;i<size;i++){r[i]=[];for(var j=0;j<size;j++)r[i][j]=0}score=0;s.textContent='0';render();addTile();addTile();removeOverlay()}function render(){removeTiles();var cw=T().width-16,gap=8,ps=(cw-gap*3)/4;for(var i=0;i<size;i++){for(var j=0;j<size;j++){var v=r[i][j];if(v===0)continue;var el=document.createElement('div');el.className='tile';el.textContent=v;var sz=v<100?28:v<1000?22:18;el.style.fontSize=sz+'px';var left=j*(ps+gap),top=i*(ps+gap),colors=getColors(v);el.style.width=ps+'px';el.style.height=ps+'px';el.style.left=left+'px';el.style.top=top+'px';el.style.background=colors.bg;el.style.color=colors.fg;if(v>=2048){el.style.boxShadow='0 0 20px '+colors.bg};g.appendChild(el);t=el}}requestAnimationFrame(function(){var els=g.querySelectorAll('.tile:not(.placed)');els.forEach(function(e){e.classList.add('placed')})})}function removeTiles(){var els=g.querySelectorAll('.tile');els.forEach(function(e){e.remove()})}function getColors(v){var m={'2':{bg:'#1a1a3e',fg:'#e0e0f0'},'4':{bg:'#2a1a4e',fg:'#e0e0f0'},'8':{bg:'#5B2D8E',fg:'#fff'},'16':{bg:'#7c3aed',fg:'#fff'},'32':{bg:'#9333EA',fg:'#fff'},'64':{bg:'#A855F7',fg:'#fff'},'128':{bg:'#C084FC',fg:'#0A0A0F'},'256':{bg:'#D8B4FE',fg:'#0A0A0F'},'512':{bg:'#FBBF24',fg:'#0A0A0F'},'1024':{bg:'#FB923C',fg:'#0A0A0F'},'2048':{bg:'#FF6B6B',fg:'#0A0A0F'}};return m[v]||{bg:'#2a2a3d',fg:'#e0e0e0'}}function slideRow(arr){var f=arr.filter(function(v){return v!==0}),r=[],sc=0;for(var i=0;i<f.length;i++){if(i+1<f.length&&f[i]===f[i+1]){r.push(f[i]*2);sc+=f[i]*2;i++}else{r.push(f[i])}}while(r.length<size)r.push(0);return{row:r,score:sc}}function move(d){var moved=false,sc=0;for(var i=0;i<size;i++){var arr=[];for(var j=0;j<size;j++){var val=d==='l'?r[i][j]:d==='r'?r[i][size-1-j]:d==='u'?r[j][i]:r[size-1-j][i];arr.push(val)}var res=slideRow(arr);if(d==='r'||d==='d')res.row.reverse();for(var j=0;j<size;j++){var ni=d==='l'?i:d==='r'?i:d==='u'?j:size-1-j,nj=d==='l'?j:d==='r'?size-1-j:d==='u'?i:i;if(r[ni][nj]!==res.row[j])moved=true;r[ni][nj]=res.row[j]}sc+=res.score}if(!moved)return false;score+=sc;s.textContent=score;if(score>best){best=score;b.textContent=best;localStorage.setItem('d2048_best',best.toString())}render();spawnParticles(sc);playSound(sc>256?1:sc>64?.7:.4);var over=isGameOver();if(over)showOver();else addTile();return true}function isGameOver(){for(var i=0;i<size;i++)for(var j=0;j<size;j++){if(r[i][j]===0)return false;if(j+1<size&&r[i][j]===r[i][j+1])return false;if(i+1<size&&r[i][j]===r[i+1][j])return false}return true}function showOver(){var ov=document.createElement('div');ov.className='gover';ov.id='gover';ov.innerHTML='<h2>Game Over</h2><p>Score: '+score+'</p><button onclick='location.reload()'>Play Again</button>';g.appendChild(ov)}function removeOverlay(){var ov=document.getElementById('gover');if(ov)ov.remove()}function spawnParticles(pt){if(pt<=0)return;var c=T();var cx=c.width/2,cy=c.height/2;for(var k=0;k<Math.min(pt/2,20);k++){var p=document.createElement('div');p.className='particle';var sz=4+Math.random()*8,clr=['#8B5CF6','#A855F7','#C084FC','#FBBF24','#FF6B6B'][Math.floor(Math.random()*5)],ang=Math.random()*Math.PI*2,dist=40+Math.random()*80;p.style.width=sz+'px';p.style.height=sz+'px';p.style.background=clr;p.style.left=cx+'px';p.style.top=cy+'px';p.style.setProperty('--dx',Math.cos(ang)*dist+'px');p.style.setProperty('--dy',Math.sin(ang)*dist+'px');g.appendChild(p);setTimeout(function(){p.remove()},700)}}function playSound(v){try{var c=new(window.AudioContext||window.webkitAudioContext)();var o=c.createOscillator();var gn=c.createGain();o.type='sine';o.frequency.setValueAtTime(220+v*440,0);o.frequency.exponentialRampToValueAtTime(440+v*880,.1);gn.gain.setValueAtTime(.12,0);gn.gain.exponentialRampToValueAtTime(.001,.15);o.connect(gn);gn.connect(c.destination);o.start();o.stop(.15)}catch(e){}}var sx=0,sy=0;g.addEventListener('touchstart',function(e){var t=e.touches[0];sx=t.clientX;sy=t.clientY},{passive:true});g.addEventListener('touchmove',function(e){e.preventDefault()},{passive:false});g.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-sx,dy=e.changedTouches[0].clientY-sy,absX=Math.abs(dx),absY=Math.abs(dy);if(Math.max(absX,absY)<20)return;if(absX>absY){move(dx>0?'r':'l')}else{move(dy>0?'d':'u')}},{passive:true});document.addEventListener('keydown',function(e){var k=e.key;if(k==='ArrowLeft')move('l');else if(k==='ArrowRight')move('r');else if(k==='ArrowUp')move('u');else if(k==='ArrowDown')move('d');else return;e.preventDefault()});document.getElementById('newBtn').addEventListener('click',function(){init()});init()})()</script>"
}
