{
  "id": "d2048",
  "name": "d2048",
  "icon": "🎮",
  "description": "A polished 2048 puzzle game with smooth animations, touch swipe, and high scores",
  "longDescription": "Classic 2048 with a dark AgentOS-themed makeover. Swipe or drag to merge tiles and chase your best score. Features animated tile slides, merge particles, sound effects, and persistent high scores.",
  "category": "game",
  "version": "2.0.0",
  "author": "maxnebula",
  "instructions": "<div id=\"app\">\n  <div class=\"header\">\n    <div class=\"title\">2048</div>\n    <div class=\"scoreboard\">\n      <div class=\"score-box\">\n        <span class=\"score-label\">SCORE</span>\n        <span class=\"score-value\" id=\"score\">0</span>\n      </div>\n      <div class=\"score-box\">\n        <span class=\"score-label\">BEST</span>\n        <span class=\"score-value\" id=\"best\">0</span>\n      </div>\n    </div>\n  </div>\n  <div class=\"grid\" id=\"grid\">\n    <div class=\"grid-bg\" id=\"gridBg\"></div>\n    <div class=\"tile-container\" id=\"tileContainer\"></div>\n    <div class=\"game-over\" id=\"gameOver\">\n      <div class=\"game-over-content\">\n        <div class=\"game-over-title\">Game Over</div>\n        <div class=\"game-over-score\" id=\"finalScore\">0</div>\n        <button class=\"btn\" id=\"retryBtn\">Play Again</button>\n      </div>\n    </div>\n  </div>\n  <div class=\"footer\">\n    <span class=\"hint\" id=\"hint\">Swipe or arrow keys to move</span>\n    <button class=\"btn btn-sm\" id=\"newBtn\">New Game</button>\n  </div>\n</div>\n\n<style>\n* { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }\nbody { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: #0A0A0F; color: #e0e0e0; display: flex; justify-content: center; align-items: center; min-height: 100vh; overflow: hidden; touch-action: none; }\n#app { width: 100%; max-width: 420px; padding: 16px; }\n.header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.title { font-size: 36px; font-weight: 900; color: #8B5CF6; letter-spacing: -1px; }\n.scoreboard { display: flex; gap: 8px; }\n.score-box { background: #151528; border: 1px solid #2a2a3d; border-radius: 10px; padding: 4px 14px; text-align: center; min-width: 75px; }\n.score-label { display: block; font-size: 9px; color: #8B8FA3; text-transform: uppercase; letter-spacing: 1px; }\n.score-value { display: block; font-size: 20px; font-weight: 700; color: #fff; }\n.grid { position: relative; width: 100%; aspect-ratio: 1; background: #0D0D1A; border-radius: 16px; border: 1px solid #1a1a2e; padding: 8px; overflow: hidden; }\n.grid-bg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; width: 100%; height: 100%; }\n.grid-bg .cell { background: #151528; border-radius: 8px; }\n.tile-container { position: absolute; inset: 8px; }\n.tile { position: absolute; display: flex; align-items: center; justify-content: center; font-weight: 800; border-radius: 8px; transition: top 0.1s ease, left 0.1s ease; }\n.tile.pop { animation: pop 0.2s ease; }\n.tile.merge { animation: merge 0.2s ease; z-index: 3; }\n@keyframes pop { 0% { transform: scale(0); opacity: 0; } 60% { transform: scale(1.1); } 100% { transform: scale(1); opacity: 1; } }\n@keyframes merge { 0% { transform: scale(1); } 40% { transform: scale(1.2); } 100% { transform: scale(1); } }\n.particle { position: absolute; pointer-events: none; border-radius: 50%; z-index: 5; animation: fly 0.6s ease-out forwards; }\n@keyframes fly { 0% { transform: translate(0, 0) scale(1); opacity: 1; } 100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; } }\n.game-over { position: absolute; inset: 0; background: rgba(10, 10, 15, 0.85); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 10; border-radius: 16px; }\n.game-over.show { display: flex; }\n.game-over-content { text-align: center; }\n.game-over-title { font-size: 40px; font-weight: 900; color: #8B5CF6; margin-bottom: 4px; }\n.game-over-score { font-size: 22px; color: #e0e0e0; margin-bottom: 24px; font-weight: 600; }\n.btn { background: #7c3aed; border: none; border-radius: 12px; padding: 14px 40px; color: #fff; font-size: 16px; font-weight: 700; cursor: pointer; touch-action: manipulation; }\n.btn:active { filter: brightness(1.3); }\n.btn-sm { background: #2a2a3d; padding: 8px 20px; font-size: 13px; font-weight: 600; }\n.btn-sm:active { filter: brightness(1.4); }\n.footer { display: flex; justify-content: space-between; align-items: center; margin-top: 12px; }\n.hint { font-size: 12px; color: #8B8FA3; }\n.win-msg { position: absolute; inset: 0; background: rgba(10, 10, 15, 0.85); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 9; border-radius: 16px; }\n.win-msg.show { display: flex; }\n.win-msg .title { font-size: 36px; font-weight: 900; color: #FBBF24; margin-bottom: 4px; }\n.win-msg .sub { font-size: 14px; color: #8B8FA3; margin-bottom: 20px; }\n</style>\n\n<script>\n(function() {\n  var SIZE = 4;\n  var grid = [];\n  var score = 0;\n  var best = parseInt(localStorage.getItem('2048_best') || '0', 10);\n  var isGameOver = false;\n  var isProcessing = false;\n  var tileId = 0;\n\n  var elScore = document.getElementById('score');\n  var elBest = document.getElementById('best');\n  var elGridBg = document.getElementById('gridBg');\n  var elTiles = document.getElementById('tileContainer');\n  var elGameOver = document.getElementById('gameOver');\n  var elFinalScore = document.getElementById('finalScore');\n  var elRetry = document.getElementById('retryBtn');\n  var elNew = document.getElementById('newBtn');\n  var elHint = document.getElementById('hint');\n\n  elBest.textContent = best;\n\n  function initGrid() {\n    elGridBg.innerHTML = '';\n    for (var i = 0; i < SIZE * SIZE; i++) {\n      var c = document.createElement('div');\n      c.className = 'cell';\n      elGridBg.appendChild(c);\n    }\n  }\n\n  function init() {\n    grid = [];\n    for (var i = 0; i < SIZE; i++) {\n      grid[i] = [];\n      for (var j = 0; j < SIZE; j++) {\n        grid[i][j] = 0;\n      }\n    }\n    score = 0;\n    isGameOver = false;\n    isProcessing = false;\n    elScore.textContent = '0';\n    elGameOver.classList.remove('show');\n    render();\n    addRandomTile();\n    addRandomTile();\n  }\n\n  function getEmptyCells() {\n    var cells = [];\n    for (var i = 0; i < SIZE; i++) {\n      for (var j = 0; j < SIZE; j++) {\n        if (grid[i][j] === 0) cells.push({ i: i, j: j });\n      }\n    }\n    return cells;\n  }\n\n  function addRandomTile() {\n    var empty = getEmptyCells();\n    if (empty.length === 0) return false;\n    var pos = empty[Math.floor(Math.random() * empty.length)];\n    grid[pos.i][pos.j] = Math.random() < 0.9 ? 2 : 4;\n    return true;\n  }\n\n  function getTileSize() {\n    var rect = elTiles.getBoundingClientRect();\n    var w = rect.width;\n    var gap = 8;\n    return (w - gap * 3) / 4;\n  }\n\n  function render() {\n    var existing = elTiles.querySelectorAll('.tile');\n    existing.forEach(function(el) { el.remove(); });\n\n    var ts = getTileSize();\n    var gap = 8;\n\n    for (var i = 0; i < SIZE; i++) {\n      for (var j = 0; j < SIZE; j++) {\n        var val = grid[i][j];\n        if (val === 0) continue;\n\n        var el = document.createElement('div');\n        el.className = 'tile';\n        el.textContent = val;\n        el.style.width = ts + 'px';\n        el.style.height = ts + 'px';\n        el.style.left = (j * (ts + gap)) + 'px';\n        el.style.top = (i * (ts + gap)) + 'px';\n\n        var colors = getColors(val);\n        el.style.backgroundColor = colors.bg;\n        el.style.color = colors.fg;\n        el.style.fontSize = (val < 100 ? 28 : val < 1000 ? 22 : 18) + 'px';\n\n        if (val >= 2048) {\n          el.style.boxShadow = '0 0 20px ' + colors.bg;\n        }\n\n        elTiles.appendChild(el);\n      }\n    }\n  }\n\n  function getColors(val) {\n    var map = {\n      '2': { bg: '#1a1a3e', fg: '#e0e0f0' },\n      '4': { bg: '#2a1a4e', fg: '#e0e0f0' },\n      '8': { bg: '#5B2D8E', fg: '#fff' },\n      '16': { bg: '#7c3aed', fg: '#fff' },\n      '32': { bg: '#9333EA', fg: '#fff' },\n      '64': { bg: '#A855F7', fg: '#fff' },\n      '128': { bg: '#C084FC', fg: '#0A0A0F' },\n      '256': { bg: '#D8B4FE', fg: '#0A0A0F' },\n      '512': { bg: '#FBBF24', fg: '#0A0A0F' },\n      '1024': { bg: '#FB923C', fg: '#0A0A0F' },\n      '2048': { bg: '#FF6B6B', fg: '#0A0A0F' },\n    };\n    return map[String(val)] || { bg: '#2a2a3d', fg: '#e0e0e0' };\n  }\n\n  function slideRow(row) {\n    var filtered = row.filter(function(v) { return v !== 0; });\n    var result = [];\n    var sc = 0;\n    for (var i = 0; i < filtered.length; i++) {\n      if (i + 1 < filtered.length && filtered[i] === filtered[i + 1]) {\n        result.push(filtered[i] * 2);\n        sc += filtered[i] * 2;\n        i++;\n      } else {\n        result.push(filtered[i]);\n      }\n    }\n    while (result.length < SIZE) result.push(0);\n    return { row: result, score: sc };\n  }\n\n  function move(direction) {\n    if (isGameOver || isProcessing) return false;\n    isProcessing = true;\n\n    var moved = false;\n    var totalScore = 0;\n\n    for (var i = 0; i < SIZE; i++) {\n      var line = [];\n      for (var j = 0; j < SIZE; j++) {\n        switch (direction) {\n          case 'left': line.push(grid[i][j]); break;\n          case 'right': line.push(grid[i][SIZE - 1 - j]); break;\n          case 'up': line.push(grid[j][i]); break;\n          case 'down': line.push(grid[SIZE - 1 - j][i]); break;\n        }\n      }\n      var result = slideRow(line);\n      if (direction === 'right' || direction === 'down') result.row.reverse();\n\n      for (var j = 0; j < SIZE; j++) {\n        var ni, nj;\n        switch (direction) {\n          case 'left': ni = i; nj = j; break;\n          case 'right': ni = i; nj = SIZE - 1 - j; break;\n          case 'up': ni = j; nj = i; break;\n          case 'down': ni = SIZE - 1 - j; nj = i; break;\n        }\n        if (grid[ni][nj] !== result.row[j]) moved = true;\n        grid[ni][nj] = result.row[j];\n      }\n      totalScore += result.score;\n    }\n\n    if (!moved) {\n      isProcessing = false;\n      return false;\n    }\n\n    score += totalScore;\n    elScore.textContent = score;\n\n    if (score > best) {\n      best = score;\n      elBest.textContent = best;\n      try { localStorage.setItem('2048_best', String(best)); } catch (e) {}\n    }\n\n    render();\n    spawnParticles(totalScore);\n\n    if (totalScore > 0) {\n      playSound(Math.min(totalScore / 256, 1));\n    }\n\n    if (!addRandomTile()) {\n      // Grid full - check game over\n      if (checkGameOver()) {\n        showGameOver();\n      }\n    } else {\n      if (checkGameOver()) {\n        showGameOver();\n      }\n    }\n\n    isProcessing = false;\n    return true;\n  }\n\n  function checkGameOver() {\n    for (var i = 0; i < SIZE; i++) {\n      for (var j = 0; j < SIZE; j++) {\n        if (grid[i][j] === 0) return false;\n        if (j + 1 < SIZE && grid[i][j] === grid[i][j + 1]) return false;\n        if (i + 1 < SIZE && grid[i][j] === grid[i + 1][j]) return false;\n      }\n    }\n    return true;\n  }\n\n  function showGameOver() {\n    isGameOver = true;\n    elFinalScore.textContent = score;\n    elGameOver.classList.add('show');\n  }\n\n  function spawnParticles(pts) {\n    if (pts <= 0) return;\n    var gridRect = document.getElementById('grid').getBoundingClientRect();\n    var cx = gridRect.width / 2;\n    var cy = gridRect.height / 2;\n    var count = Math.min(Math.floor(pts / 4), 25);\n\n    for (var k = 0; k < count; k++) {\n      var p = document.createElement('div');\n      p.className = 'particle';\n      var sz = 4 + Math.random() * 10;\n      var colors = ['#8B5CF6', '#A855F7', '#C084FC', '#FBBF24', '#FF6B6B'];\n      var clr = colors[Math.floor(Math.random() * colors.length)];\n      var angle = Math.random() * Math.PI * 2;\n      var dist = 40 + Math.random() * 100;\n      p.style.width = sz + 'px';\n      p.style.height = sz + 'px';\n      p.style.background = clr;\n      p.style.left = cx + 'px';\n      p.style.top = cy + 'px';\n      p.style.setProperty('--dx', Math.cos(angle) * dist + 'px');\n      p.style.setProperty('--dy', Math.sin(angle) * dist + 'px');\n      elTiles.appendChild(p);\n      setTimeout(function(el) { el.remove(); }, 700, p);\n    }\n  }\n\n  function playSound(intensity) {\n    try {\n      var ctx = new (window.AudioContext || window.webkitAudioContext)();\n      var osc = ctx.createOscillator();\n      var gain = ctx.createGain();\n      var baseFreq = 220 + intensity * 440;\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(baseFreq, 0);\n      osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.5, 0.08);\n      gain.gain.setValueAtTime(0.1, 0);\n      gain.gain.exponentialRampToValueAtTime(0.001, 0.12);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start();\n      osc.stop(0.12);\n    } catch (e) {}\n  }\n\n  // Touch handling\n  var touchStartX = 0, touchStartY = 0;\n  var gridEl = document.getElementById('grid');\n\n  gridEl.addEventListener('touchstart', function(e) {\n    var t = e.touches[0];\n    touchStartX = t.clientX;\n    touchStartY = t.clientY;\n  }, { passive: true });\n\n  gridEl.addEventListener('touchmove', function(e) {\n    e.preventDefault();\n  }, { passive: false });\n\n  gridEl.addEventListener('touchend', function(e) {\n    var dx = e.changedTouches[0].clientX - touchStartX;\n    var dy = e.changedTouches[0].clientY - touchStartY;\n    var absX = Math.abs(dx);\n    var absY = Math.abs(dy);\n    if (Math.max(absX, absY) < 30) return;\n    if (absX > absY) {\n      move(dx > 0 ? 'right' : 'left');\n    } else {\n      move(dy > 0 ? 'down' : 'up');\n    }\n  }, { passive: true });\n\n  // Keyboard handling\n  document.addEventListener('keydown', function(e) {\n    var keyMap = {\n      'ArrowLeft': 'left', 'ArrowRight': 'right', 'ArrowUp': 'up', 'ArrowDown': 'down'\n    };\n    var dir = keyMap[e.key];\n    if (dir) {\n      e.preventDefault();\n      move(dir);\n    }\n  });\n\n  // Mouse drag handling (for desktop testing)\n  var mouseStartX = 0, mouseStartY = 0, isDragging = false;\n  gridEl.addEventListener('mousedown', function(e) {\n    mouseStartX = e.clientX;\n    mouseStartY = e.clientY;\n    isDragging = true;\n  });\n  document.addEventListener('mousemove', function(e) {\n    if (isDragging) e.preventDefault();\n  });\n  document.addEventListener('mouseup', function(e) {\n    if (!isDragging) return;\n    isDragging = false;\n    var dx = e.clientX - mouseStartX;\n    var dy = e.clientY - mouseStartY;\n    var absX = Math.abs(dx);\n    var absY = Math.abs(dy);\n    if (Math.max(absX, absY) < 30) return;\n    if (absX > absY) {\n      move(dx > 0 ? 'right' : 'left');\n    } else {\n      move(dy > 0 ? 'down' : 'up');\n    }\n  });\n\n  // Button handlers\n  function newGame() {\n    init();\n  }\n\n  elRetry.addEventListener('click', newGame);\n  elNew.addEventListener('click', newGame);\n\n  // Start the game\n  initGrid();\n  init();\n})();\n</script>\n"
}