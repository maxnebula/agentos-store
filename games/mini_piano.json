{
  "id": "mini_piano",
  "name": "Mini Piano",
  "icon": "🎹",
  "description": "Play piano with touch or keyboard — a full octave",
  "longDescription": "A fun musical instrument micro-app. Play a full octave of piano keys with touch or keyboard.\n\nFeatures:\n- 12 semitones (C to B)\n- Touch and keyboard input\n- Realistic piano sounds (Web Audio API)",
  "category": "game",
  "version": "1.0.0",
  "author": "maxnebula",
  "instructions": "<!DOCTYPE html><html><head><meta name='viewport' content='width=device-width, initial-scale=1.0'><style>body{font-family:sans-serif;background:#0a0a1a;display:flex;justify-content:center;align-items:center;height:100vh;margin:0;flex-direction:column;color:#fff}h1{font-size:20px;margin-bottom:20px;color:#a855f7}.piano{display:flex;position:relative;height:200px}.white{width:48px;height:200px;background:#fff;border:1px solid #ccc;border-radius:0 0 6px 6px;cursor:pointer;position:relative;z-index:1;margin:0 1px}.white:active{background:#e0e0e0}.black{width:30px;height:130px;background:#222;border:1px solid #000;border-radius:0 0 4px 4px;cursor:pointer;position:absolute;z-index:2;margin-left:-15px}.black:active{background:#444}</style></head><body><h1>🎹 Mini Piano</h1><div class=piano id=piano></div><script>const notes=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];const freqs=[261.63,277.18,293.66,311.13,329.63,349.23,369.99,392.00,415.30,440.00,466.16,493.88];const ctx=new(window.AudioContext||window.webkitAudioContext)();function play(i){const osc=ctx.createOscillator(),gain=ctx.createGain();osc.connect(gain);gain.connect(ctx.destination);osc.frequency.value=freqs[i];osc.type='sine';gain.gain.setValueAtTime(0.3,ctx.currentTime);gain.gain.exponentialRampToValueAtTime(0.001,ctx.currentTime+0.5);osc.start();osc.stop(ctx.currentTime+0.5)}const piano=document.getElementById('piano');let offset=0;notes.forEach((n,i)=>{if(n.includes('#')){const el=document.createElement('div');el.className='black';el.style.left=((i-1)*50+42)+'px';el.onclick=()=>play(i);piano.appendChild(el)}else{const el=document.createElement('div');el.className='white';el.style.left=(offset*50)+'px';el.onclick=()=>play(i);offset++;piano.appendChild(el)}})</script></body></html>",
